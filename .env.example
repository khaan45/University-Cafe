# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit real credentials.

PORT=4000

# eDahab (docs.edahab.net)
EDAHAB_API_KEY=your_edahab_api_key
EDAHAB_AGENT_CODE=your_edahab_agent_code

# Zaad (Telesom) — issued after their business application/contract process
ZAAD_MERCHANT_ID=your_zaad_merchant_id
ZAAD_API_KEY=your_zaad_api_key
